# 全球市场日报 - 配置文件
# 复制 .env.example 为 .env 并填写 API Keys

# Finnhub API Key (https://finnhub.io)
FINNHUB_API_KEY=d99krbpr01qssj13oimgd99krbpr01qssj13oin0

# Alpha Vantage API Key (https://www.alphavantage.co)
ALPHA_VANTAGE_KEY=MPRTK22FUOXTVHAJ

# NewsAPI Key (https://newsapi.org)
