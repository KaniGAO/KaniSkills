# FRED API Key (https://fred.stlouisfed.org)
FRED_API_KEY=9650d484604c64da09f9a28bea79e780

# Hunyuan 校验模型（每日 6 点实跑时用于网页核验 / 多源检测，确保数据绝对真实）
# 不填则不启用网页校验，链路照常运行
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
# 设为 1 启用网页校验（每日自动化建议开启）
ENABLE_WEB_VERIFY=0

# Gmail SMTP 配置（用于发送日报）
GMAIL_SENDER_EMAIL=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# 收件人邮箱（JSON 数组格式）
RECIPIENT_EMAILS=["your-email@example.com"]

# 日报输出路径（记忆规则：docx 落此路径，文件名 global-markets-briefing-YYYY-MM-DD.docx）
OUTPUT_DIR=/Users/gaokanglin/CodeBuddy/Claw/reports
